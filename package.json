{
  "name": "portafolio-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "set \"BROWSER=chrome\" && ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prestart": "node scripts/configure-license.cjs",
    "prebuild": "node scripts/configure-license.cjs",
    "pretest": "node scripts/configure-license.cjs",
    "prewatch": "node scripts/configure-license.cjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@primeuix/themes": "^3.0.1",
    "@tailwindcss/postcss": "^4.1.13",
    "postcss": "^8.5.6",
    "primeng": "^22.1.2",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-primeui": "^0.6.1",
    "three": "^0.186.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/jasmine": "~5.1.0",
    "@types/three": "^0.186.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
